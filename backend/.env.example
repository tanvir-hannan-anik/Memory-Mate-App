# Supabase (database + storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Gladia (Bangla voice transcription + speaker diarization)
# Free: 10 hrs/month — https://app.gladia.io
GLADIA_API_KEY=your-gladia-key

# Gemini 2.5 Flash — use 4 different Google accounts for 4x free quota (250 req/day each)
# Get keys at: https://aistudio.google.com
GEMINI_KEY_EXTRACTION=key-from-account-1
GEMINI_KEY_CHAT=key-from-account-2
GEMINI_KEY_SUMMARY=key-from-account-3
GEMINI_KEY_NAMING=key-from-account-4

# CORS — comma-separated list of allowed frontend origins
# Example: https://memory-mate-app.vercel.app,https://yourdomain.com
# Leave as * for development (unrestricted)
ALLOWED_ORIGINS=*
